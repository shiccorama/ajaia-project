# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values for your machine.
# `.env.local` is git-ignored. Never commit real credentials.
#
# NOTE: this project uses host port 15432 for the Docker Postgres container because
# the machine already runs a native PostgreSQL on 5432. Change the port to match
# your own setup.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (dev / production).
DATABASE_URL=postgres://ajaia:ajaia_dev_pw@localhost:15432/ajaia

# Isolated database used by the automated tests. It is wiped between suites.
TEST_DATABASE_URL=postgres://ajaia:ajaia_dev_pw@localhost:15432/ajaia_test

# Maximum upload size in bytes (default 1048576 = 1 MB).
MAX_UPLOAD_BYTES=1048576

# Session lifetime in days (default 7).
SESSION_TTL_DAYS=7

# Enables the demo account switcher at POST /api/auth/demo-login.
# Demo-only. Never enable this as a substitute for real authentication.
DEMO_MODE=true
